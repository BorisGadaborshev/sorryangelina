{
  "name": "retro-board-server",
  "version": "1.0.0",
  "private": true,
  "description": "Retro board backend server",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development npm run migrate:up && NODE_ENV=development nodemon --exec \"node -r ts-node/register/transpile-only\" src/server.ts",
    "build": "tsc",
    "test": "node --test test/*.test.cjs",
    "watch": "tsc -w",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --envPath .env",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.12.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
