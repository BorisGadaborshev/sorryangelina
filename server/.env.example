# Local development only. Copy to server/.env (gitignored).
# `npm run dev` loads this file, then server/.env.local overrides it.
# Production ignores .env.local and uses the process environment
# (deploy/sorryangelina.service). Do not put production secrets here.

PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/retro_board
JWT_SECRET=change-me-for-local
